NEXT_PUBLIC_SUPABASE_URL=
# Primary: the publishable key from the Supabase dashboard (`sb_publishable_...`).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative: the older anon public key. Only used when the
# publishable key above is not set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables AI receipt scanning (Expenses → Scan receipt). Restart the
# dev server after setting it.
# Alibaba Cloud Model Studio API key, required for receipt scanning.
MODELSTUDIO_API_KEY=
# OpenAI-compatible workspace endpoint.
# Default: https://ws-tnjldzt0y8y9na5y.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
MODELSTUDIO_BASE_URL=
# Vision model used for extraction. Default: qwen-vl-plus
# (the workspace denies `-latest` aliases; use bare model ids)
MODELSTUDIO_MODEL=
